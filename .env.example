# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Cryptographic secret for signing HTTP-only session cookies.
# A secure ephemeral secret is generated automatically in development if omitted.
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# PI_API_KEY: Official Pi Network Developer Portal Server API Key (Testnet).
# Required for server-side payment approval and completion against api.testnet.minepi.com.
PI_API_KEY=""

# PI_ENVIRONMENT: Keep set to "testnet" until official Mainnet approvals & credentials are active.
PI_ENVIRONMENT="testnet"
PI_TESTNET_WALLET="GDD4KZEBDEJMYJYP6O5SCBHE5GGIF6K3RTHCF4ZGIWWIPGAHLTTXZB2O"

# Optional server-side initial administrator bootstrap (never exposed to frontend):
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
